# ==============================================================================
# Environment Configuration Template (.env.example)
# DO NOT store real API secrets, tokens, or private passwords in this file.
# Copy this file to '.env' for local configuration. Ensure '.env' is in '.gitignore'.
# ==============================================================================

# Public Frontend Service Endpoint (Example: Formspree Contact Endpoint)
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/mdekbvjj

# Backend API Base URL (For production backend service communication)
PUBLIC_API_BASE_URL=https://api.your-domain.com

# ⚠️ SECURITY NOTICE:
# Never prefix secret API keys or private database credentials with public prefixes.
# Private keys (e.g., DATABASE_URL, STRIPE_SECRET_KEY, AWS_SECRET_ACCESS_KEY) MUST 
# remain strictly on server-side backends and NEVER be referenced in frontend JavaScript!
