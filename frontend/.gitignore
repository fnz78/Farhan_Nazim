# ==============================================================================
# Git Ignore - Prevent Secrets & Sensitive Environment Files From Committing
# ==============================================================================

# Environment files containing sensitive keys, tokens, or credentials
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.env

# API Keys, Private Certificates, and Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub
secrets/
config/secrets.*
*.secret

# Logs & Debugging
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node modules & Build outputs
node_modules/
dist/
build/
.cache/

# Operating System & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
